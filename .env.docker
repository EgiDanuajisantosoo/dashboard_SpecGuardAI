# =============================================================================
# SpecGuard AI — Docker Environment Variables
# =============================================================================

APP_NAME=SpecGuardAI
APP_ENV=local
APP_KEY=base64:BeQ9ATj2sX2RDX26XwQE7EKhwZFe/0U+s+806j6DzMw=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (Docker postgres service) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=specguard
DB_USERNAME=specguard
DB_PASSWORD=specguard_secret

# --- Session ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Queue (Redis-backed) ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# --- Cache ---
CACHE_STORE=redis

# --- Redis (Docker redis service) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"

# --- AI / OpenAI-compatible API ---
# Replace with your actual API key
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gemini-1.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_REQUEST_TIMEOUT=120

# --- GitHub ---
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
